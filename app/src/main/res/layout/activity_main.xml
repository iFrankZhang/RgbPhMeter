<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <!-- 取景区：预览 + 冻结图 + 选框叠加层，三者尺寸完全一致 -->
    <FrameLayout
        android:id="@+id/stage"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="5"
        android:background="@color/accent_soft">

        <androidx.camera.view.PreviewView
            android:id="@+id/preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ImageView
            android:id="@+id/frozen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:visibility="gone" />

        <com.rgbph.meter.SelectionOverlay
            android:id="@+id/overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/modeTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:background="@drawable/btn_primary"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="实时"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />
    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="5">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- 操作按钮 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnFreeze"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_primary"
                    android:text="冻结画面"
                    android:textColor="#FFFFFF" />

                <Space android:layout_width="8dp" android:layout_height="1dp" />

                <Button
                    android:id="@+id/btnGallery"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_soft"
                    android:text="从相册选图"
                    android:textColor="@color/fg" />

                <Space android:layout_width="8dp" android:layout_height="1dp" />

                <Button
                    android:id="@+id/btnRecord"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_soft"
                    android:text="记录读数"
                    android:textColor="@color/fg" />
            </LinearLayout>

            <!-- 读数 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/panel_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <View
                    android:id="@+id/swatch"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/swatch_bg" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvRgb"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="R –   G –   B –"
                        android:textColor="@color/fg"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvPix"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="拖动方框选中色块"
                        android:textColor="@color/muted"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/panel_bg"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="pH" android:textColor="@color/muted" android:textSize="12sp" />
                    <TextView android:id="@+id/tvPh" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:fontFamily="monospace" android:text="–" android:textColor="@color/accent"
                        android:textSize="28sp" android:textStyle="bold" />
                    <TextView android:id="@+id/tvPhF" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:fontFamily="monospace" android:textColor="@color/muted" android:textSize="11sp" />
                </LinearLayout>

                <Space android:layout_width="10dp" android:layout_height="1dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/panel_bg"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="细菌数量" android:textColor="@color/muted" android:textSize="12sp" />
                    <TextView android:id="@+id/tvBac" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:fontFamily="monospace" android:text="–" android:textColor="@color/accent"
                        android:textSize="28sp" android:textStyle="bold" />
                    <TextView android:id="@+id/tvBacF" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:fontFamily="monospace" android:textColor="@color/muted" android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tvWarn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/warn"
                android:textSize="12sp"
                android:visibility="gone" />

            <!-- 公式系数 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/panel_bg"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="换算公式（改完立即生效）" android:textColor="@color/muted" android:textSize="12sp" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center_vertical" android:orientation="horizontal" android:layout_marginTop="6dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="pH = " android:textColor="@color/fg" android:fontFamily="monospace" />
                    <EditText android:id="@+id/etPa" android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:inputType="numberDecimal|numberSigned"
                        android:fontFamily="monospace" android:textColor="@color/fg" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text=" × R + " android:textColor="@color/fg" android:fontFamily="monospace" />
                    <EditText android:id="@+id/etPb" android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:inputType="numberDecimal|numberSigned"
                        android:fontFamily="monospace" android:textColor="@color/fg" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="菌 = " android:textColor="@color/fg" android:fontFamily="monospace" />
                    <EditText android:id="@+id/etBa" android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:inputType="numberDecimal|numberSigned"
                        android:fontFamily="monospace" android:textColor="@color/fg" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text=" × R + " android:textColor="@color/fg" android:fontFamily="monospace" />
                    <EditText android:id="@+id/etBb" android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:inputType="numberDecimal|numberSigned"
                        android:fontFamily="monospace" android:textColor="@color/fg" />
                </LinearLayout>
            </LinearLayout>

            <!-- 记录 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/panel_bg"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="读数记录" android:textColor="@color/muted" android:textSize="12sp" />

                <LinearLayout
                    android:id="@+id/logList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/tvLogEmpty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="还没有记录。点「记录读数」添加。"
                    android:textColor="@color/muted"
                    android:textSize="13sp" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:orientation="horizontal">
                    <Button android:id="@+id/btnShare" style="?android:attr/borderlessButtonStyle"
                        android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1"
                        android:background="@drawable/btn_soft" android:text="导出 CSV" android:textColor="@color/fg" />
                    <Space android:layout_width="8dp" android:layout_height="1dp" />
                    <Button android:id="@+id/btnClear" style="?android:attr/borderlessButtonStyle"
                        android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1"
                        android:background="@drawable/btn_soft" android:text="清空记录" android:textColor="@color/fg" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
